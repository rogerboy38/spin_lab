{
 "doctype": "DocType", "name": "Progressive Meter", "module": "Spin Lab",
 "engine": "InnoDB", "autoname": "field:meter_name",
 "field_order": ["meter_name", "meter_type", "enabled", "current_value", "seed",
                 "contribution_rate", "hit_probability", "must_hit_max",
                 "trigger_threshold", "hits", "total_contributed", "last_hit_value"],
 "fields": [
